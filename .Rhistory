# =====================================================================
# Codigo para extraer datos de estaciones DGA / Felipe Garcia
# =====================================================================
## Limpiar ambiente
#-------------------
rm(list=ls())
graphics.off()
cat("\014")
## Paquetes
#-------------------
library(openxlsx)
## Directorio de trabajo
#-------------------
setwd("C:/Codigos/Datos_DGA")
dir_inputs  <- file.path(getwd(), "Inputs")
dir_outputs <- file.path(getwd(), "Outputs")
if (!dir.exists(dir_outputs)) dir.create(dir_outputs)
## Carga de estaciones desde Excel
#-------------------
estaciones <- openxlsx::read.xlsx(file.path(dir_inputs, "STATIONS.xlsx"),
colNames = TRUE)[[1]]
## Carga de archivos .txt disponibles
#-------------------
files_txt <- list.files(dir_inputs, pattern = "\\.txt$", full.names = TRUE)
## Funcion para limpiar nombres de pestañas
#-------------------
clean_sheetname <- function(name) {
# Reemplazar tildes y caracteres especiales
name <- iconv(name, to = "ASCII//TRANSLIT")
# Eliminar caracteres no permitidos en Excel: \ / * ? : [ ]
name <- gsub("[\\\\/*?:\\[\\]]", "", name, perl = TRUE)
# Eliminar espacios al inicio y al final
name <- trimws(name)
# Limitar a 31 caracteres
name <- substr(name, 1, 31)
return(name)
}
## Extraccion de datos por estacion
#-------------------
for (estacion in estaciones) {
message(paste("\nProcesando estacion:", estacion))
wb            <- createWorkbook()
sheets_added  <- 0
for (file_txt in files_txt) {
# Leer archivo .txt
df <- tryCatch(
read.csv(file_txt, sep = ",", header = TRUE),
error = function(e) {
message(paste("  Error al leer:", basename(file_txt)))
return(NULL)
}
)
if (is.null(df)) next
# Verificar si la estacion existe en este archivo
if (!(estacion %in% df$NOMBRE.ESTACION)) {
message(paste("  Sin datos en:", basename(file_txt), "- Saltando..."))
next
}
# Filtrar por estacion
df_estacion <- df[df$NOMBRE.ESTACION == estacion, ]
# Obtener nombre variable (penultima columna)
nombre_variable <- as.character(unique(df_estacion[, ncol(df_estacion) - 1])[1])
# Limpiar nombre de pestaña
nombre_variable <- clean_sheetname(nombre_variable)
message(paste("  Nombre pestaña limpio:", nombre_variable))
# Agregar hoja al workbook
addWorksheet(wb, sheetName = nombre_variable)
writeData(wb, sheet = nombre_variable, x = df_estacion, rowNames = FALSE)
sheets_added <- sheets_added + 1
message(paste("  Variable agregada:", nombre_variable))
}
# Guardar solo si tiene al menos una hoja con datos
if (sheets_added > 0) {
output_file <- file.path(dir_outputs, paste0(estacion, ".xlsx"))
saveWorkbook(wb, file = output_file, overwrite = TRUE)
message(paste("  Guardado:", basename(output_file)))
} else {
message(paste("  Sin datos disponibles para:", estacion))
}
}
